# Copy this file to .env (or set these as environment variables
# in your hosting provider's dashboard) before going live.

# Required in production — a long random string used to sign
# session cookies. If you don't set this, the server makes up a
# temporary one on every restart, which logs everyone out each
# time you redeploy. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The admin account's password. Change this from the default
# before you publish the site.
ADMIN_PASSWORD=ChangeMe123!

# Optional — override any seed member's initial password (only
# used the very first time the server runs, before data/ exists).
# SEED_PASSWORD_JAYPEE=
# SEED_PASSWORD_NEA=
# SEED_PASSWORD_JASMINE=
# SEED_PASSWORD_JOSHUA=
# SEED_PASSWORD_BJAY=
# SEED_PASSWORD_AXEL=

# Optional — port the server listens on (most hosts set this for you).
PORT=3000
